@model Prexam.Models.Collection
@{
    ViewData["Title"] = "Start Exam";
}

<div class="text-center mb-4">
    <h2 class="fw-bold">@Model.Title</h2>
    <p class="text-secondary">Duration: @Model.Duration minutes</p>
</div>

<form asp-action="SubmitExam" method="post" class="mx-auto" style="max-width: 600px;">
    <input type="hidden" name="collectionId" value="@Model.CollectionCode" />

    <div class="card mb-4 p-3">
        <label class="fw-bold mb-2">1. 2 + 2 = ?</label>
        <div>
            <div><input type="radio" name="answers[Q1]" value="3" /> 3</div>
            <div><input type="radio" name="answers[Q1]" value="4" /> 4</div>
            <div><input type="radio" name="answers[Q1]" value="5" /> 5</div>
        </div>
    </div>

    <div class="card mb-4 p-3">
        <label class="fw-bold mb-2">2. 5 × 3 = ?</label>
        <div>
            <div><input type="radio" name="answers[Q2]" value="8" /> 8</div>
            <div><input type="radio" name="answers[Q2]" value="15" /> 15</div>
            <div><input type="radio" name="answers[Q2]" value="20" /> 20</div>
        </div>
    </div>

    <div class="text-center">
        <button type="submit" class="btn btn-primary px-4 py-2">Submit Exam</button>
    </div>
</form>
