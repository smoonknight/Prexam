@model List<Prexam.Models.Collection>
@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="text-center mb-4 fw-bold">Choose Your Exam Collection</h2>
<div class="row">
    @foreach (var exam in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 text-center p-3">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title fw-bold text-white">@exam.Title</h5>
                        <p class="text-secondary mb-2">@exam.Duration minutes</p>
                    </div>
                    <a asp-controller="Exam" asp-action="Start" asp-route-id="@exam.CollectionCode" class="btn btn-outline-primary mt-3">Start</a>
                </div>
            </div>
        </div>
    }
</div>
