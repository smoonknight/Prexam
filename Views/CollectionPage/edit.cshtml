@model Prexam.Models.Collection
@{
    ViewData["Title"] = "Edit Collection";
}

<h2 class="text-center mb-4 fw-bold text-white">Edit Collection</h2>

<div class="card bg-dark border border-secondary shadow-lg p-4 rounded-4">
    <form asp-action="Edit" asp-route-collectionCode="@Model.CollectionCode" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CollectionCode" />

        <div class="mb-3">
            <label asp-for="Title" class="form-label text-white fw-semibold"></label>
            <input asp-for="Title" class="form-control bg-dark text-white border-secondary" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label text-white fw-semibold"></label>
            <textarea asp-for="Description" class="form-control bg-dark text-white border-secondary"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Duration" class="form-label text-white fw-semibold"></label>
            <input asp-for="Duration" type="number" class="form-control bg-dark text-white border-secondary" />
            <span asp-validation-for="Duration" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between">
            <button type="submit" class="btn btn-primary w-50 me-2">Save Changes</button>
            <a asp-action="Index" class="btn btn-secondary w-50 ms-2">Cancel</a>
        </div>
    </form>
</div>

<hr class="text-secondary my-5" />

<h3 class="text-white fw-bold mb-3">Questions</h3>

<div class="mb-4">
    <a asp-controller="CollectionPage" 
       asp-action="CreateQuestion" 
       asp-route-collectionCode="@Model.CollectionCode"
       class="btn btn-success">
        + Add New Question
    </a>
</div>

@if (Model.Questions != null && Model.Questions.Any())
{
    <div class="list-group">
        @foreach (var question in Model.Questions)
        {
            <div class="list-group-item bg-dark text-white border-secondary mb-2 rounded-3 d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="fw-bold mb-1">@question.Description</h6>
                    <p class="mb-0 text-secondary small">
                        @string.Join(", ", question.Options ?? Array.Empty<string>())
                    </p>
                </div>
                <div>
                    <a asp-controller="CollectionPage" 
                       asp-action="EditQuestion" 
                       asp-route-collectionCode="@Model.CollectionCode" 
                       asp-route-questionId="@question.Id"
                       class="btn btn-outline-warning btn-sm me-2">
                        Edit
                    </a>
                    <a asp-controller="CollectionPage" 
                       asp-action="DeleteQuestion" 
                       asp-route-collectionCode="@Model.CollectionCode" 
                       asp-route-questionId="@question.Id"
                       class="btn btn-outline-danger btn-sm">
                        Delete
                    </a>
                </div>
            </div>
        }
    </div>
}
else
{
    <p class="text-secondary">No questions added yet.</p>
}
