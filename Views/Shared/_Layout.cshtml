<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Prexam</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet" />
    <style>
        body {
            background-color: #0f1115;
            color: #e5e5e5;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .navbar {
            background: linear-gradient(90deg, #0f1115 0%, #15181f 100%);
            border-bottom: 1px solid #1f2230;
        }
        .navbar-brand {
            font-weight: 700;
            color: #00e0ff !important;
            font-size: 1.4rem;
            letter-spacing: 1px;
        }
        .card {
            background-color: #15181f;
            border: 1px solid #242836;
            transition: transform .2s ease, box-shadow .2s ease;
        }
        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 0 15px #00e0ff33;
        }
        .btn-primary {
            background: linear-gradient(90deg, #00e0ff 0%, #00b4d8 100%);
            border: none;
        }
        .btn-primary:hover {
            background: linear-gradient(90deg, #00b4d8 0%, #0096c7 100%);
        }
        .btn-outline-primary {
            border-color: #00e0ff;
            color: #00e0ff;
        }
        .btn-outline-primary:hover {
            background: #00e0ff;
            color: #0f1115;
        }
        h1, h2, h3, h4 {
            color: #ffffff;
        }
        input[type="radio"] {
            accent-color: #00e0ff;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Prexam</a>
        </div>
    </nav>

    <div class="container py-5">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
